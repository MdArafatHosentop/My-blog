source "https://rubygems.org"

gem "jekyll", "~> 3.9"
gem "github-pages", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

# Minimal Mistakes থিমের জন্য প্রয়োজনীয় প্লাগইন
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-data"
  gem "jemoji"
end